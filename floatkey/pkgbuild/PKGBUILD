pkgname=floatkey
pkgver=0.5.2
pkgrel=1
pkgdesc='iPad-style on-screen keyboard for Omarchy: docked, floating, or tucked into a corner'
arch=('x86_64' 'aarch64')
license=('MIT')
depends=('qt6-base' 'qt6-declarative' 'qt6-multimedia' 'qt6-wayland' 'layer-shell-qt' 'libxkbcommon' 'wayland' 'xkeyboard-config')
makedepends=('gcc' 'make' 'fcitx5')
optdepends=('fcitx5: show the keyboard when a text field gets focus'
            'superwhisper-bin: voice typing from the orb and mic key'
            'noto-fonts-emoji: emoji page'
            'adwaita-fonts: the key labels')
install=floatkey.install
source=()
sha256sums=()

build() {
  cd "$startdir/.."
  ./bin/build
}

package() {
  cd "$startdir/.."
  install -Dm755 build/floatkey "$pkgdir/usr/bin/floatkey"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$startdir/floatkey.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/floatkey.svg"
  install -Dm644 "$startdir/floatkey.desktop" "$pkgdir/usr/share/applications/floatkey.desktop"
  install -Dm755 build/fcitx5/libfloatkey.so "$pkgdir/usr/lib/fcitx5/libfloatkey.so"
  install -Dm644 fcitx5/floatkey.conf "$pkgdir/usr/share/fcitx5/addon/floatkey.conf"
}
