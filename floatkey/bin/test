#!/bin/sh
set -eu

ROOT="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
mkdir -p "$ROOT/build/tests"
cd "$ROOT/build/tests"

qmake6 "$ROOT/tests/floatkey_tests.pro"
make -j"$(nproc)"
# No input method: a test focusing a text field would take fcitx5's focus
# from the desktop, and dictated text would go to the test instead.
QT_IM_MODULE=none QT_QPA_PLATFORM=offscreen ./floatkey_tests
