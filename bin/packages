#!/bin/bash
# Builds every Omarchy Pad package into a folder, without installing anything, for an install image's input or a
# package repository:
#
#   bin/packages OUTDIR
#
# The parts are built from this checkout as it is; buffybox, which comes from upstream source, is built only when
# OUTDIR has none yet.
set -euo pipefail

root=$(cd "$(dirname "$0")/.." && pwd)
out=$(mkdir -p "${1:?usage: bin/packages OUTDIR}" && cd "$1" && pwd)

# --nodeps: the machine that builds them needn't have what they need at run time (a PC builds them for a tablet,
# whose sensor and device packages it lacks). What the builds themselves need must be installed.
build() {
  echo "== $1"
  (cd "$root/$1" && PKGDEST=$out makepkg -f --nodeps --noconfirm --cleanbuild >/dev/null)
}

for p in keyring/pkgbuild floatkey/pkgbuild stage/pkgbuild tablet/pkgbuild shell/pkgbuild lock/pkgbuild firstboot/pkgbuild pkgbuild; do
  build "$p"
done
compgen -G "$out/buffybox-*.pkg.tar.*" >/dev/null || build firstboot/buffybox

cd "$out"
ls -1 ./*.pkg.tar.*
