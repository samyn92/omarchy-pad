#!/bin/bash
# omarchy-pad-power against fake commands: Hyprland, the shell, systemctl, the journal and Omarchy's commands only log
# what they are asked (and answer as the case says), so nothing here sleeps, locks or opens anything.
#
#   tests/power-button

set -u
here=$(cd "$(dirname "$0")/.." && pwd)
work=$(mktemp -d "${TMPDIR:-/tmp}/power-button.XXXXXX")
trap 'rm -rf "$work"' EXIT
mkdir -p "$work/bin" "$work/run" "$work/sys/panel"
export XDG_RUNTIME_DIR=$work/run PATH="$work/bin:$PATH" WORK=$work OMARCHY_PAD_SYS_BACKLIGHT=$work/sys \
  OMARCHY_PAD_SUSPEND_COUNT=$work/suspends OMARCHY_PAD_SLEEP_AFTER=0.2

# Each fake logs its command line, and answers from $WORK/<name> when that file is there.
fake() {
  cat >"$work/bin/$1" <<FAKE
#!/bin/bash
echo "$1 \$*" >>"\$WORK/log"
$2
FAKE
  chmod +x "$work/bin/$1"
}
fake hyprctl '[[ -e $WORK/screen-off ]] && echo "[{\"disabled\":false,\"dpmsStatus\":false}]" || echo "[{\"disabled\":false,\"dpmsStatus\":true}]"'
fake omarchy-hyprland-session-locked '[[ -e $WORK/locked ]]'
# The kernel's last resume: now, or 1.5 s ago ("resumed-earlier"), or none
fake journalctl 'if [[ -e $WORK/resumed ]]; then echo "$EPOCHREALTIME pad kernel: PM: suspend exit"; elif [[ -e $WORK/resumed-earlier ]]; then awk -v t="$EPOCHREALTIME" "BEGIN { printf \"%.6f pad kernel: PM: suspend exit\n\", t - 1.5 }"; fi'
fake omarchy-shell 'case "$1 $2" in "shell summon") [[ -e $WORK/no-plugin ]] && echo unknown || echo ok ;; "shell call") [[ -e $WORK/open ]] && echo true || echo false ;; "lock status") [[ -e $WORK/lock-stuck ]] && echo "{\"secure\":false}" || echo "{\"secure\":true}" ;; esac'
# The backlight: get answers the brightness, set writes it; the panel's power follows the screen.
fake brightnessctl 'case "$*" in *get*) cat $WORK/sys/panel/brightness ;; *set*) echo "${@: -1}" >$WORK/sys/panel/brightness ;; esac'
# A suspend that is not refused counts one, as the kernel's suspend_stats/success does once it has woken up
fake systemctl '[[ -e $WORK/inhibited ]] && { echo "Operation inhibited by \"iceland-battery-guard\"" >&2; exit 1; }; echo $(( $(cat $WORK/suspends) + 1 )) >$WORK/suspends'
fake omarchy-sleep-disabled 'exit 1'
fake omarchy-toggle-enabled 'exit 1'
fake omarchy-brightness-display '[[ $1 == off ]] && { touch $WORK/screen-off; echo 4 >$WORK/sys/panel/bl_power; }; :'
for c in omarchy-system-lock omarchy-system-wake omarchy-menu omarchy-capture-screenshot \
  omarchy-audio-output-volume logger; do
  fake "$c" ':'
done
cat >"$work/bin/logger" <<'FAKE'
#!/bin/bash
echo "said: ${*: -1}" >>"$WORK/log"
FAKE
chmod +x "$work/bin/logger"

power=$here/bin/omarchy-pad-power
failures=0
reset() {
  rm -f "$work"/{log,screen-off,locked,resumed,resumed-earlier,no-plugin,open,inhibited,lock-stuck}; rm -rf "$work/run"; mkdir -p "$work/run"
  touch "$work/log"; echo 1417 >"$work/sys/panel/brightness"; echo 0 >"$work/sys/panel/bl_power"; echo 5 >"$work/suspends"
}
# What it did: the commands that act, leaving out the questions it asks on the way.
did() {
  grep -v -E '^(hyprctl monitors|journalctl|omarchy-hyprland-session-locked|omarchy-sleep-disabled|omarchy-toggle-enabled|omarchy-shell shell call|omarchy-shell lock status|brightnessctl -d panel get)' \
    "$work/log" | paste -sd ';'
}
expect() {
  if [[ $2 == "$3" ]]; then echo "ok    $1"; else echo "FAIL  $1: got '$2', want '$3'"; failures=$((failures + 1)); fi
}
tap() { "$power" press; sleep 0.1; "$power" release; sleep 0.8; }
hold() { "$power" press; sleep 0.9; "$power" release; sleep 0.2; }

reset; tap
expect "a tap darkens the screen first, locks behind it, turns it off, puts the brightness back and sleeps" "$(did)" \
  "brightnessctl -q -d panel set 0;omarchy-system-lock ;omarchy-brightness-display off;brightnessctl -q -d panel set 1417;systemctl suspend --no-ask-password"
expect "and the brightness is back" "$(cat "$work/sys/panel/brightness")" 1417

reset; touch "$work/inhibited"; tap
expect "where sleep is held off, the screen stays off and locked" "$(did | sed 's/said: .*/said/')" \
  "brightnessctl -q -d panel set 0;omarchy-system-lock ;omarchy-brightness-display off;brightnessctl -q -d panel set 1417;systemctl suspend --no-ask-password;said"

reset; touch "$work/lock-stuck"; tap; sleep 1.2
expect "a lock that never says it is up still ends dark, with the brightness back" \
  "$(cat "$work/sys/panel/brightness") $(cat "$work/sys/panel/bl_power")" "1417 4"

reset; touch "$work/screen-off"; tap
expect "with the screen off, a tap turns it on" "$(did)" "hyprctl dispatch hl.dsp.dpms({ action = \"enable\" })"

reset; OMARCHY_PAD_SLEEP_AFTER=1.5 "$power" press; sleep 0.1; OMARCHY_PAD_SLEEP_AFTER=1.5 "$power" release; sleep 0.8
: >"$work/log"; tap; sleep 1.5
expect "a tap while the screen is dark but the tablet not yet asleep lights it, and the sleep is called off" "$(did)" \
  "hyprctl dispatch hl.dsp.dpms({ action = \"enable\" })"
expect "and it tells the lock screen to wake as a touch does" "$(test -s "$work/run/omarchy-pad-power/wake" && echo yes)" yes

reset; touch "$work/screen-off"; "$power" press; sleep 0.1; rm -f "$work/screen-off"; "$power" release; sleep 0.8
expect "the screen as it was at the press counts: lit by something else before the release, it is not slept" \
  "$(did)" "hyprctl dispatch hl.dsp.dpms({ action = \"enable\" })"

reset; touch "$work/resumed"; tap
expect "the press that woke the tablet does nothing more" "$(did)" "said: the press that woke the tablet: the screen on, nothing more"

reset; tap; rm -f "$work/screen-off"; : >"$work/log"; tap
expect "the press after a sleep it sent is the wake press, even before the journal says so" "$(did)" \
  "said: the press that woke the tablet: the screen on, nothing more"
tap
expect "and the press after that sleeps again" "$(did | cut -d';' -f2-3)" "brightnessctl -q -d panel set 0;omarchy-system-lock "

reset; tap; rm -f "$work/screen-off"; read -r c m <"$work/run/omarchy-pad-power/slept"
echo "$c $(awk -v m="$m" 'BEGIN { print m - 10 }')" >"$work/run/omarchy-pad-power/slept"; : >"$work/log"; tap
expect "a press long after waking (5 s or more awake) sleeps" "$(did | cut -d';' -f1)" "brightnessctl -q -d panel set 0"

reset; touch "$work/inhibited"; tap; rm -f "$work/screen-off"; : >"$work/log"; tap
expect "where sleep was refused, the next press is not taken for a wake press" "$(did | cut -d';' -f1)" "brightnessctl -q -d panel set 0"

reset; touch "$work/resumed-earlier"; tap
expect "a press 1.5 s after waking is a new press: it sleeps" "$(did | cut -d';' -f1-2)" \
  "brightnessctl -q -d panel set 0;omarchy-system-lock "

reset; touch "$work/resumed" "$work/screen-off"; tap
expect "and lights the screen if the wake left it dark" "$(did)" \
  "hyprctl dispatch hl.dsp.dpms({ action = \"enable\" });said: the press that woke the tablet: the screen on, nothing more"

reset; hold
expect "holding opens the power screen, and letting go does nothing more" "$(did)" \
  "omarchy-shell shell summon omarchy-pad.power {}"

reset; touch "$work/no-plugin"; hold
expect "without the power screen, Omarchy's power menu" "$(did)" \
  "omarchy-shell shell summon omarchy-pad.power {};omarchy-menu summon system"

reset; touch "$work/locked"; hold
expect "held on the lock screen: nothing opens over it" "$(did)" \
  "said: held on the lock screen: no power screen"

reset; touch "$work/open"; tap
expect "a tap while the power screen is open closes it" "$(did)" "omarchy-shell shell hide omarchy-pad.power"

reset; "$power" press; sleep 0.1; "$power" volume-down; "$power" volume-down; sleep 0.1; "$power" release; sleep 0.8
expect "Power + Volume Down takes one screenshot, and no sleep" "$(did)" "omarchy-capture-screenshot fullscreen"

reset; "$power" volume-down
expect "Volume Down alone turns the volume down" "$(did)" "omarchy-audio-output-volume lower"

reset; "$power" release & sleep 0.05; "$power" press; wait; sleep 0.8
expect "a release started before its press still counts as a tap" "$(did)" \
  "brightnessctl -q -d panel set 0;omarchy-system-lock ;omarchy-brightness-display off;brightnessctl -q -d panel set 1417;systemctl suspend --no-ask-password"

((failures)) && { echo "$failures failed"; exit 1; }
echo "All passed"
