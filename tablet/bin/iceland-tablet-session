#!/bin/bash
# OnePlus Pad 4 tablet session for Omarchy's Hyprland, started by hypr/iceland_tablet.lua:
#  - auto-rotate: follows iio-sensor-proxy's accelerometer (monitor-sensor) and turns the panel, the touch
#    screen and the pen together, unless the rotation lock is on (iceland-rotate-lock);
#  - the on-screen keyboard (floatkey, else wvkbd), started hidden; iceland-osk shows and hides it;
#  - touch gestures: stage's edge swipes (split a window, pull the scratchpad down) when it is installed, and
#    lisgd for the 3-finger ones, restarted with every rotation so its edges follow the screen.
# Settings: ~/.config/iceland/tablet.conf (PANEL, SCALE, ROTATE_FLIP, GESTURES, GESTURE_DISTANCE; see
# install-tablet-setup.sh).
set -u

conf=${XDG_CONFIG_HOME:-$HOME/.config}/iceland/tablet.conf
state=${XDG_RUNTIME_DIR:-/tmp}/iceland-tablet
lock=${XDG_CONFIG_HOME:-$HOME/.config}/iceland/rotation-locked
PANEL=DSI-1 SCALE=2 ROTATE_FLIP=0 GESTURES=1 GESTURE_DISTANCE=150
# shellcheck source=/dev/null
[[ -r $conf ]] && . "$conf"
mkdir -p "$state"

# only one session per login
exec 9>"$state/lock"
flock -n 9 || exit 0

log() { echo "iceland-tablet: $*" >&2; }

start_osk() {
  if command -v floatkey >/dev/null; then
    floatkey --hidden 9>&- &
    return
  fi
  command -v wvkbd-mobintl >/dev/null || { log "neither floatkey nor wvkbd is installed: no on-screen keyboard"; return; }
  pgrep -u "$USER" -x wvkbd-mobintl >/dev/null || wvkbd-mobintl --hidden -L 300 -H 420 9>&- &
}

# Omarchy 4.5's Hyprland takes Lua dispatchers; the plain form stays as a fallback
dsp() { # dsp LUA PLAIN
  printf "hyprctl dispatch '%s' >/dev/null 2>&1 || hyprctl dispatch %s" "$1" "$2"
}

start_stage() {
  command -v stage >/dev/null || return 0
  pgrep -u "$USER" -x stage >/dev/null || stage 9>&- &
}

# lisgd gestures: three fingers across the screen, and with no stage to handle them, one finger from an edge. Edges are in screen terms: lisgd reads the
# output's transform from Wayland when it starts (and maps 90/270 to its own counting), so it is restarted after each
# rotation instead of being given -o.
gestures() {
  ((GESTURES)) && command -v lisgd >/dev/null || return 0
  [[ -n ${touch_dev:-} ]] || return 0
  pkill -u "$USER" -x lisgd
  # the lock's descriptor stays out of children, or a leftover lisgd would block the next session start
  local edges=()
  if command -v stage >/dev/null; then
    # stage owns the edges; the keyboard comes up when a text field is tapped
    edges=(-g "3,RL,*,*,R,$(dsp 'hl.dsp.focus({ workspace = "m+1" })' 'workspace m+1')"
      -g "3,LR,*,*,R,$(dsp 'hl.dsp.focus({ workspace = "m-1" })' 'workspace m-1')")
  else
    edges=(-g '1,DU,B,*,R,iceland-osk toggle'
      -g '1,UD,T,*,R,omarchy-menu'
      -g "1,RL,R,*,R,$(dsp 'hl.dsp.focus({ workspace = "m+1" })' 'workspace m+1')"
      -g "1,LR,L,*,R,$(dsp 'hl.dsp.focus({ workspace = "m-1" })' 'workspace m-1')")
  fi
  # Two fingers pulled down close the window they're on (touching it focused it); a shorter two-finger
  # movement, like a scroll, stays harmless. lisgd's own distances are thirds of the screen, and a pull
  # measured on the tablet runs 110 to 400 px, so every gesture here needs GESTURE_DISTANCE desktop pixels
  # instead (-t counts the panel's pixels), and may lean 22 degrees off its direction, not 15.
  local close min
  min=$(awk -v d="$GESTURE_DISTANCE" -v s="$SCALE" 'BEGIN { printf "%d", d * s }')
  close=$(dsp 'hl.dsp.window.close()' 'killactive')
  lisgd -d "$touch_dev" -t "$min" -r 22 "${edges[@]}" \
    -g "2,UD,*,*,R,$close" \
    -g "3,DU,*,*,R,$(dsp 'hl.dsp.window.fullscreen({ mode = "maximized" })' 'fullscreen 1')" \
    -g "3,UD,*,*,R,$close" 9>&- &
}

transform_of() { # iio-sensor-proxy orientation -> Hyprland transform
  local t
  case $1 in
    normal) t=0 ;;
    left-up) t=1 ;;
    bottom-up) t=2 ;;
    right-up) t=3 ;;
    *) return 1 ;;
  esac
  # a panel mounted the other way round: swap the two portrait directions
  ((ROTATE_FLIP)) && ((t % 2)) && t=$(((t + 2) % 4))
  echo "$t"
}

apply() { # apply TRANSFORM
  hyprctl eval "hl.monitor({ output = \"$PANEL\", mode = \"preferred\", position = \"0x0\", scale = $SCALE, transform = $1 })
hl.config({ input = { touchdevice = { output = \"$PANEL\", transform = $1 }, tablet = { output = \"$PANEL\", transform = $1 } } })" >/dev/null ||
    log "hyprctl eval failed for transform $1"
  echo "$1" >"$state/transform"
  # Hyprland turns the output a moment after eval returns, and lisgd reads the transform only as it starts
  local i
  for ((i = 0; i < 20; i++)); do
    [[ $(hyprctl -j monitors | jq -r --arg p "$PANEL" '.[] | select(.name == $p) | .transform') == "$1" ]] && break
    sleep 0.05
  done
  gestures
}

# Hyprland names devices in lower case with dashes for spaces; find the evdev node with that name
touch_dev=""
if name=$(omarchy-hw-touchscreen 2>/dev/null) && [[ -n $name ]]; then
  for d in /sys/class/input/event*; do
    n=$(cat "$d/device/name" 2>/dev/null) || continue
    n=${n,,}
    [[ ${n// /-} == "$name" ]] && { touch_dev=/dev/input/${d##*/}; break; }
  done
fi

start_osk
start_stage
gestures

command -v monitor-sensor >/dev/null || { log "monitor-sensor (iio-sensor-proxy) is missing: no auto-rotate"; wait; exit 0; }

current=""
monitor-sensor --accel 9>&- | while IFS= read -r line; do
  case $line in
    *"orientation changed: "*) o=${line##*changed: } ;;
    *"(orientation: "*) o=${line##*orientation: }; o=${o%)*} ;;
    *) continue ;;
  esac
  [[ -e $lock ]] && continue
  t=$(transform_of "$o") || continue
  [[ $t == "$current" ]] && continue
  current=$t
  apply "$t"
done
