#!/bin/bash
# Show, hide or toggle the on-screen keyboard: omarchy-pad-osk [toggle|show|hide]
# floatkey when it is installed (it starts itself if needed), else wvkbd.
if command -v floatkey >/dev/null; then
  case ${1:-toggle} in
    show | hide | toggle) exec floatkey "${1:-toggle}" ;;
    *) echo "usage: omarchy-pad-osk [toggle|show|hide]" >&2; exit 2 ;;
  esac
fi
# wvkbd: SIGUSR1 hides, SIGUSR2 shows, SIGRTMIN toggles.
case ${1:-toggle} in
  show) sig=USR2 ;;
  hide) sig=USR1 ;;
  toggle) sig=RTMIN ;;
  *) echo "usage: omarchy-pad-osk [toggle|show|hide]" >&2; exit 2 ;;
esac
if ! pkill -"$sig" -u "$USER" -x wvkbd-mobintl; then
  command -v wvkbd-mobintl >/dev/null || { notify-send "On-screen keyboard" "wvkbd is not installed"; exit 1; }
  [[ $sig == USR1 ]] || setsid -f wvkbd-mobintl -L 300 -H 420 >/dev/null 2>&1
fi
