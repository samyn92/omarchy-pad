#!/bin/bash
# Omarchy Pad's tablet session for Omarchy's Hyprland, started by hypr/omarchy_pad_tablet.lua:
#  - auto-rotate: follows iio-sensor-proxy's accelerometer (monitor-sensor) and turns the panel, the touch
#    screen and the pen together, unless the rotation lock is on (omarchy-pad-rotate-lock);
#  - the on-screen keyboard (floatkey, else wvkbd), started hidden; omarchy-pad-osk shows and hides it;
#  - touch gestures: stage, which does them all (edge swipes, two fingers pulling a window down to close it,
#    three-finger swipes) and follows the rotation itself.
#  - the power button: holds a handle-power-key inhibitor for the session, which says the session handles the key
#    (omarchy-pad-power, bound in hypr/omarchy_pad_tablet.lua), so a device layer that watches it leaves it alone.
# Settings: PANEL, SCALE and ROTATE_FLIP, from the files lib/tablet-conf lists.
set -u

here=$(dirname "$(readlink -f "$0")")
lib=$here/../lib
[[ -r $lib/tablet-conf ]] || lib=/usr/lib/omarchy-pad
# shellcheck source=../lib/tablet-conf
. "$lib/tablet-conf"
state=${XDG_RUNTIME_DIR:-/tmp}/omarchy-pad-tablet
lock=${XDG_CONFIG_HOME:-$HOME/.config}/omarchy-pad/rotation-locked
mkdir -p "$state"

# only one session per login
exec 9>"$state/lock"
flock -n 9 || exit 0

log() { echo "omarchy-pad-tablet: $*" >&2; }

start_osk() {
  if command -v floatkey >/dev/null; then
    floatkey --hidden 9>&- &
    return
  fi
  command -v wvkbd-mobintl >/dev/null || { log "neither floatkey nor wvkbd is installed: no on-screen keyboard"; return; }
  pgrep -u "$USER" -x wvkbd-mobintl >/dev/null || wvkbd-mobintl --hidden -L 300 -H 420 9>&- &
}

start_stage() {
  command -v stage >/dev/null || return 0
  pgrep -u "$USER" -x stage >/dev/null || stage 9>&- &
}

transform_of() { # iio-sensor-proxy orientation -> Hyprland transform
  local t
  case $1 in
    normal) t=0 ;;
    left-up) t=1 ;;
    bottom-up) t=2 ;;
    right-up) t=3 ;;
    *) return 1 ;;
  esac
  # a panel mounted the other way round: swap the two portrait directions
  ((ROTATE_FLIP)) && ((t % 2)) && t=$(((t + 2) % 4))
  echo "$t"
}

apply() { # apply TRANSFORM
  hyprctl eval "hl.monitor({ output = \"$PANEL\", mode = \"preferred\", position = \"0x0\", scale = $SCALE, transform = $1 })
hl.config({ input = { touchdevice = { output = \"$PANEL\", transform = $1 }, tablet = { output = \"$PANEL\", transform = $1 } } })" >/dev/null ||
    log "hyprctl eval failed for transform $1"
  echo "$1" >"$state/transform"
}

# floatkey and stage read the touch screen themselves, through the access logind gives the user at the screen
# (70-omarchy-pad-touch.rules, uaccess). The session can start a moment before that access is there, and both then
# give up on touch for the whole session ("can't read the touch screen": image 15, 3 Nov 2026). So wait for it, up
# to 30 s; a tablet without a touch screen starts them at once.
wait_for_touch() {
  local e i
  for ((i = 0; i < 150; i++)); do
    local touch=0 readable=0
    for e in /dev/input/event*; do
      udevadm info -q property -n "$e" 2>/dev/null | grep -qx 'ID_INPUT_TOUCHSCREEN=1' || continue
      touch=1
      [[ -r $e ]] && readable=1
    done
    ((touch == 0 || readable)) && return 0
    sleep 0.2
  done
  log "the touch screen is still not readable after 30 s; starting floatkey and stage anyway"
}

start_power_key() {
  systemd-inhibit --what=handle-power-key --mode=block --who="Omarchy Pad" \
    --why="The power button sleeps the tablet or opens the power screen" sleep infinity 9>&- &
}

start_power_key
wait_for_touch
start_osk
start_stage

command -v monitor-sensor >/dev/null || { log "monitor-sensor (iio-sensor-proxy) is missing: no auto-rotate"; wait; exit 0; }

current=""
monitor-sensor --accel 9>&- | while IFS= read -r line; do
  case $line in
    *"orientation changed: "*) o=${line##*changed: } ;;
    *"(orientation: "*) o=${line##*orientation: }; o=${o%)*} ;;
    *) continue ;;
  esac
  [[ -e $lock ]] && continue
  t=$(transform_of "$o") || continue
  [[ $t == "$current" ]] && continue
  current=$t
  apply "$t"
done
