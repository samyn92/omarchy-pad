# lisgd 0.4.0 with one fix: when the last finger up had never moved (a resting thumb, a tap), the fingers counted
# so far carried over into the next gesture. After a scroll with a thumb resting on the screen, the next two-finger
# swipe down (close) could count as one finger and do nothing.
pkgname=lisgd
pkgver=0.4.0
pkgrel=2
pkgdesc='Bind gestures on touchscreens, and unsupported gesture devices via libinput touch events'
arch=('x86_64' 'aarch64')
url='https://git.sr.ht/~mil/lisgd'
license=('MIT')
depends=('libinput' 'libx11' 'wayland')
source=("$pkgname-$pkgver.tar.gz::https://git.sr.ht/~mil/lisgd/archive/$pkgver.tar.gz"
        'lisgd-still-finger.patch')
sha256sums=('1eef0a3c4c297714b52dd061d40611c955ea8479ef3e60cfb0f7ab9cb22e65e7'
            '98bd12559067a442eba4e06f55c45bf2bb2fa357827f82981c96422e19c4a78e')

prepare() {
  cd "$pkgname-$pkgver"
  patch -p1 <"$srcdir/lisgd-still-finger.patch"
}

build() {
  cd "$pkgname-$pkgver"
  make
}

package() {
  cd "$pkgname-$pkgver"
  make DESTDIR="$pkgdir" PREFIX=/usr install
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
