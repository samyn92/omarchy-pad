#!/bin/bash

# Opens a nested Hyprland in a window running the power screen plugin in a harness shell (tests/harness/shell.qml).
# Its buttons run fake Omarchy commands that only log, so nothing here powers off, restarts or locks the session.
#
#   tests/try          leaves it open to try by hand; closing the window ends it
#   tests/try --check  taps it with finger events, says what passed, and closes it

set -euo pipefail

here=$(cd "$(dirname "$0")/.." && pwd)
shell_root="${OMARCHY_PATH:-/usr/share/omarchy}/shell"
work=$(mktemp -d "${TMPDIR:-/tmp}/power-try.XXXXXX")
check=0
[[ ${1:-} == --check ]] && check=1

mkdir -p "$work/shell/plugins" "$work/omarchy/bin"
cp "$here/tests/harness/shell.qml" "$work/shell/"
ln -s "$shell_root/Commons" "$work/shell/Commons"
ln -s "$shell_root/Ui" "$work/shell/Ui"
"$here/../bin/install" --to "$work/shell/plugins" "$(basename "$here")" >/dev/null
touch "$work/commands.log"
for command in omarchy-system omarchy-system-lock; do
  printf '#!/bin/bash\necho "%s $*" >> %s/commands.log\n' "$command" "$work" >"$work/omarchy/bin/$command"
  chmod +x "$work/omarchy/bin/$command"
done

cat >"$work/hyprland.lua" <<LUA
hl.monitor({ output = "", mode = "1280x800", position = "auto", scale = 1 })
hl.env("OMARCHY_PATH", "${OMARCHY_PATH:-/usr/share/omarchy}")
hl.env("FAKE_OMARCHY", "$work/omarchy")
hl.config({ misc = { disable_hyprland_logo = true, disable_splash_rendering = true } })
hl.on("hyprland.start", function ()
  hl.exec_cmd("QT_IM_MODULE=none quickshell -p $work/shell > $work/quickshell.log 2>&1")
end)
LUA

if (( ! check )); then
  echo "Work dir: $work"
  echo "Open:     qs -p $work/shell ipc --any-display call harness open"
  echo "Commands: $work/commands.log"
  status=0
  start-hyprland -- --config "$work/hyprland.lua" || status=$?
  rm -rf "$work"
  exit "$status"
fi

setsid start-hyprland -- --config "$work/hyprland.lua" >"$work/hyprland.log" 2>&1 &
nested=$!
finish() {
  kill -TERM -- "-$nested" 2>/dev/null || true
  wait "$nested" 2>/dev/null || true
  rm -rf "$work"
}
trap finish EXIT

call() { qs -p "$work/shell" ipc --any-display call harness "$@"; }
state() { call state | jq -c "$1"; }

for _ in {1..150}; do
  [[ $(call ready 2>/dev/null) == true ]] && break
  sleep 0.1
done
[[ $(call ready 2>/dev/null) == true ]] || {
  echo "The harness shell did not come up:" >&2
  tail -20 "$work/quickshell.log" >&2
  exit 1
}

failures=0
expect() {
  local what=$1 got=$2 want=$3
  if [[ $got == "$want" ]]; then
    echo "ok    $what"
  else
    echo "FAIL  $what: got $got, want $want"
    failures=$((failures + 1))
  fi
}
open() {
  call open >/dev/null
  for _ in {1..50}; do
    [[ $(state .revealed) == true ]] && break
    sleep 0.1
  done
  sleep 0.8
}

open
expect "it opens, and says so" "$(state '[.opened, .isOpen]')" '[true,"true"]'
expect "three buttons" "$(state '.buttons | length')" 3
expect "side by side on a landscape screen, power off first" \
  "$(state '.buttons | (.poweroff.y == .restart.y and .restart.y == .lock.y and .poweroff.x < .restart.x and .restart.x < .lock.x)')" true
expect "each a thumb's size or more (64 px)" "$(state '[.buttons[].size] | min >= 64')" true

call tap 0.08 0.1 >/dev/null; sleep 0.4
expect "a tap outside the buttons closes it" "$(state '[.opened, .isOpen]')" '[false,"false"]'
expect "and runs nothing" "$(wc -l <"$work/commands.log")" 0

open
call tapButton restart >/dev/null; sleep 0.4
expect "Restart restarts as Omarchy's menu does" "$(tail -1 "$work/commands.log")" "omarchy-system reboot"
expect "and closes the screen" "$(state .opened)" false

open
call tapButton lock >/dev/null; sleep 0.4
expect "Lock locks" "$(tail -1 "$work/commands.log")" "omarchy-system-lock "

open
call tapButton poweroff >/dev/null; sleep 0.4
expect "Power off shuts down" "$(tail -1 "$work/commands.log")" "omarchy-system shutdown"
expect "one command for each tap" "$(wc -l <"$work/commands.log")" 3

if (( failures )); then
  echo "$failures failed; quickshell said:"
  grep -iE "warn|error" "$work/quickshell.log" | grep -v "portal" | tail -20 || true
  exit 1
fi
echo "All passed"
