#!/bin/bash

# Opens a nested Hyprland in a window with the drawers plugin under a bar
# stand-in, so they can be pulled without touching the real shell. The
# quick settings switches run fakes (tests/fake-bin) that only log and keep
# state in the work dir; Wi-Fi is the exception, being the real
# NetworkManager's, so leave that switch alone. Closing the window ends it.
#
#   tests/try          leaves it open; closing the window ends it
#   tests/try --check  opens the notifications on a few made-up ones, swipes
#                      and taps them with finger events, says what passed,
#                      and closes it
#
# Drive it from outside with the printed commands: begin, follow, settle,
# close and state are the plugin's; harness state shows where it is.

set -euo pipefail

here=$(cd "$(dirname "$0")/.." && pwd)
omarchy_path=${OMARCHY_PATH:-/usr/share/omarchy}
shell_root="$omarchy_path/shell"
work=$(mktemp -d "${TMPDIR:-/tmp}/drawers-try.XXXXXX")
check=0
[[ ${1:-} == --check ]] && check=1

mkdir -p "$work/shell/plugins/drawers" "$work/bin" "$work/state" "$work/config"
cp "$here/tests/harness/shell.qml" "$work/shell/"
ln -s "$shell_root/Commons" "$work/shell/Commons"
ln -s "$shell_root/Ui" "$work/shell/Ui"
cp "$here"/*.qml "$here/manifest.json" "$here/quick-settings-state" "$work/shell/plugins/drawers/"

for command in omarchy-brightness-display omarchy-audio-output-sink pactl omarchy-bluetooth-power \
  iceland-rotate-lock floatkey omarchy-shell omarchy-theme-bg-switcher omarchy-agent-usage-update \
  omarchy-agent-account-add omarchy-powerprofiles-set omarchy-capture-screenshot omarchy-capture-text \
  omarchy-capture-qr; do
  ln -s "$here/tests/fake-bin/fake" "$work/bin/$command"
done
touch "$work/state/bluetooth"

# Made-up notifications for --check, in Omarchy's files' own form: one on
# screen, and earlier three from one app (a stack) and one from another.
notifications_env=""
if (( check )); then
  mkdir -p "$work/notifications"
  now=$(date +%s)
  row() { # KEY APP SUMMARY BODY AGE [CLOSED]
    local closed=""
    [[ -n ${6:-} ]] && closed=",\"closed_ts\":$(( now - $5 + 5 )),\"closed_reason\":\"expired\""
    printf '{"key":"%s","app":"%s","source":"%s","summary":"%s","body":"%s","urgency":1,"ts":%s%s}' \
      "$1" "$2" "$2" "$3" "$4" "$(( now - $5 ))" "$closed"
  }
  printf '[%s]\n' "$(row live1 Power 'Battery low' 'Plug in soon' 30)" >"$work/notifications/live.json"
  printf '[%s,%s,%s,%s]\n' \
    "$(row old1 Claude 'stage' 'pictures on the GPU' 60 1)" \
    "$(row old2 Claude 'stage' 'console follows fingers' 120 1)" \
    "$(row old3 Claude 'stage' 'bar reconnects' 180 1)" \
    "$(row old4 'Pad Tester' 'Update ready' 'Omarchy can be updated' 300 1)" >"$work/notifications/history.json"
  # An app installed under the name the last one comes from, as Claude's is.
  mkdir -p "$work/data/applications"
  printf '[Desktop Entry]\nType=Application\nName=Pad Tester\nExec=true\nIcon=utilities-terminal\n' \
    >"$work/data/applications/pad-tester.desktop"
  notifications_env="hl.env(\"DRAWERS_TRY_NOTIFICATIONS\", \"$work/notifications\")
hl.env(\"XDG_DATA_HOME\", \"$work/data\")"
fi

# A config home of its own for the rotation lock's flag file, seeing
# everything else (fonts, the theme) through links to the real one.
for entry in "${XDG_CONFIG_HOME:-$HOME/.config}"/*; do
  [[ $(basename "$entry") == iceland ]] || ln -s "$entry" "$work/config/"
done

cat >"$work/hyprland.lua" <<LUA
hl.monitor({ output = "", mode = "1280x800", position = "auto", scale = 1 })
hl.env("OMARCHY_PATH", "$omarchy_path")
hl.env("PATH", "$work/bin:$PATH")
hl.env("XDG_CONFIG_HOME", "$work/config")
hl.env("DRAWERS_TRY_STATE", "$work/state")
hl.env("DRAWERS_TRY_SOCKET", "$work/shell.sock")
hl.env("QT_IM_MODULE", "none")
$notifications_env
hl.config({ misc = { disable_hyprland_logo = true, disable_splash_rendering = true } })
hl.layer_rule({ match = { namespace = "^omarchy-pad-drawers\$" }, no_anim = true, animation = "none" })
hl.on("hyprland.start", function ()
  hl.exec_cmd("quickshell -p $work/shell > $work/quickshell.log 2>&1")
end)
LUA

call="qs -p $work/shell ipc --any-display call"

if (( check )); then
  setsid start-hyprland -- --config "$work/hyprland.lua" >"$work/hyprland.log" 2>&1 &
  nested=$!
  finish() {
    kill -TERM -- "-$nested" 2>/dev/null || true
    wait "$nested" 2>/dev/null || true
    rm -rf "$work"
  }
  trap finish EXIT
  touch_() { $call touch "$@"; }
  cards() { touch_ notifications | jq -c "$1"; }
  for _ in {1..150}; do
    [[ $($call omarchy-pad.drawers state 2>/dev/null) == closed ]] && break
    sleep 0.1
  done
  $call omarchy-pad.drawers begin left >/dev/null
  $call omarchy-pad.drawers settle 1 >/dev/null
  sleep 0.8

  failures=0
  expect() {
    local what=$1 got=$2 want=$3
    if [[ $got == "$want" ]]; then
      echo "ok    $what"
    else
      echo "FAIL  $what: got $got, want $want"
      failures=$((failures + 1))
    fi
  }
  # swipe CARD DX MS: a finger on that card, moved DX sideways over MS, let go.
  swipe() {
    touch_ press "$1" >/dev/null
    touch_ moveBy "$2" 0 "$3" >/dev/null
    touch_ release >/dev/null
    sleep "$(awk -v ms="$3" 'BEGIN { print ms / 1000 + 0.8 }')"
  }
  tap() { touch_ press "$1" >/dev/null; touch_ release >/dev/null; sleep 0.5; }

  expect "one on screen, and earlier a stack of three and one more" "$(cards .cards)" "[1,3,1]"
  expect "each card shows its notification" "$(cards .drawn)" true
  expect "one from an app that names no icon wears the app's own" "$(cards .icons[-1])" '"utilities-terminal"'
  tap 1
  expect "a tap opens the stack" "$(cards .cards)" "[1,1,1,1,1]"
  expect "and shows every one" "$(cards .drawn)" true
  swipe 1 -120 500
  expect "a short swipe puts the card back" "$(cards .cards)" "[1,1,1,1,1]"
  swipe 1 -330 400
  expect "a long one takes it away" "$(cards '[.cards, .recent, .hidden]')" "[[1,1,1,1],3,1]"
  swipe 1 80 50
  expect "and a flick does too" "$(cards '[.cards, .recent, .hidden]')" "[[1,1,1],2,2]"
  swipe 0 -330 400
  expect "the one on screen goes" "$(cards '[.live, .hidden]')" "[0,3]"
  expect "and Omarchy is asked to dismiss it" "$(grep -c 'omarchy-shell notifications dismiss Battery low' "$work/state/calls.log")" 1
  expect "what was taken away is remembered" "$(jq length "$work/state/hidden-notifications.json")" 3
  touch_ press 0 >/dev/null; touch_ moveBy 4 -150 300 >/dev/null; touch_ release >/dev/null; sleep 1
  expect "a finger going up or down takes nothing away" "$(cards .recent)" 2
  touch_ clearEarlier >/dev/null
  sleep 0.5
  expect "Clear takes all the earlier ones" "$(cards '[.recent, .hidden]')" "[0,5]"

  # The right drawer's pages: quick settings, and Omarchy's agents above it.
  hstate() { $call harness state | jq -c "$1"; }
  $call omarchy-pad.drawers close >/dev/null
  sleep 0.8
  first=$($call omarchy-pad.drawers begin right)
  $call omarchy-pad.drawers follow "$first" >/dev/null
  expect "pulled all the way, quick settings is open" "$(hstate '[.page, .turn]')" "[0,0]"
  $call omarchy-pad.drawers follow "$(( first + 80 ))" >/dev/null
  turned=$(hstate '.turn > 0 and .turn < 1')
  expect "pulling on past it starts turning the page" "$turned" true
  $call omarchy-pad.drawers settle 1 >/dev/null
  sleep 0.6
  expect "let go a little turned, it goes back to quick settings" "$(hstate '[.page, .turn]')" "[0,0]"
  $call omarchy-pad.drawers follow "$(( first + 200 ))" >/dev/null
  $call omarchy-pad.drawers settle 1 >/dev/null
  sleep 0.6
  expect "pulled on further, it turns to the agents" "$(hstate '[.page, .turn]')" "[1,1]"
  expect "which show Omarchy's agents panel" "$(hstate '.agents.content')" true
  expect "and refresh it as it opens" "$(( $(grep -c omarchy-agent-usage-update "$work/state/calls.log") > 0 ))" 1
  expect "the drawer is as tall as the agents" "$(hstate '.openHeight > .agents.height')" true
  $call omarchy-pad.drawers close >/dev/null
  sleep 0.8
  $call omarchy-pad.drawers begin right >/dev/null
  $call omarchy-pad.drawers settle 1 >/dev/null
  sleep 0.6
  expect "it opens on quick settings again" "$(hstate '[.page, .turn]')" "[0,0]"

  # Quick settings by finger.
  drag() { # NAME SHAREX SHAREY DX DY MS
    touch_ pressItem "$1" "$2" "$3" >/dev/null
    touch_ moveBy "$4" "$5" "$6" >/dev/null
    touch_ release >/dev/null
    sleep "$(awk -v ms="$6" 'BEGIN { print ms / 1000 + 0.6 }')"
  }
  before=$(hstate .settings.brightness)
  drag brightness-bar 0.5 0.5 90 0 300
  expect "a finger moving along the brightness bar raises it" "$(( $(hstate .settings.brightness) > before ))" 1
  before=$(hstate .settings.brightness)
  drag brightness-bar 0.5 0.5 0 260 400
  expect "one going down from it turns the page instead" "$(hstate '.page')" 1
  expect "and leaves the brightness alone" "$(hstate .settings.brightness)" "$before"
  drag agentsPage 0.5 0.5 0 -260 400
  expect "a push up on the agents turns back" "$(hstate '[.page, .turn]')" "[0,0]"
  drag tile-Focus 0.5 0.5 0 260 400
  expect "a swipe down from a tile turns the page too" "$(hstate '.page')" 1
  drag agentsPage 0.5 0.5 0 -260 400
  dnd=$(hstate .settings.dnd)
  touch_ pressItem tile-Focus 0.5 0.5 >/dev/null; touch_ release >/dev/null; sleep 0.5
  expect "a tap on Focus turns it over" "$(hstate .settings.dnd)" "$([[ $dnd == true ]] && echo false || echo true)"
  touch_ pressItem profiles 0.9 0.5 >/dev/null; touch_ release >/dev/null; sleep 0.5
  expect "a tap on Fast picks that power profile" "$(grep -c 'omarchy-powerprofiles-set autodetect performance' "$work/state/calls.log")" 1
  touch_ pressItem tile-Screenshot 0.5 0.5 >/dev/null; touch_ release >/dev/null; sleep 1.2
  expect "Screenshot puts the drawer away" "$($call omarchy-pad.drawers state)" closed
  expect "and then takes the whole screen" "$(grep -c 'omarchy-capture-screenshot fullscreen' "$work/state/calls.log")" 1

  if (( failures )); then
    echo "$failures failed; quickshell said:"
    grep -iE "warn|error" "$work/quickshell.log" | grep -v "portal" | tail -20 || true
    exit 1
  fi
  echo "All passed"
  exit 0
fi

echo "Work dir: $work"
echo "Pull:     $call omarchy-pad.drawers begin right   (or left)"
echo "          $call omarchy-pad.drawers follow 200"
echo "          $call omarchy-pad.drawers settle 1      (0 closes)"
echo "State:    $call harness state"
echo "Calls:    $work/state/calls.log"
status=0
start-hyprland -- --config "$work/hyprland.lua" || status=$?
rm -rf "$work"
exit "$status"
