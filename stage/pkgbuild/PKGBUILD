pkgname=stage
pkgver=0.11.2
pkgrel=1
pkgdesc='iPad-style multitasking gestures for Omarchy on a tablet'
arch=('x86_64' 'aarch64')
license=('MIT')
depends=('qt6-base' 'qt6-declarative' 'qt6-wayland' 'layer-shell-qt' 'wayland' 'libinput' 'mesa' 'libdrm' 'libglvnd'
         'hyprland' 'uwsm')
makedepends=('gcc' 'make' 'wayland-protocols')
source=()
sha256sums=()

# Kept in step with VERSION in stage.pro.
pkgver() {
  sed -n 's/^VERSION = //p' "$startdir/../stage.pro"
}

build() {
  cd "$startdir/.."
  # From scratch, so the commit --version names is the one being packaged.
  rm -rf build
  ./bin/build
}

package() {
  cd "$startdir/.."
  install -Dm755 build/stage "$pkgdir/usr/bin/stage"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
