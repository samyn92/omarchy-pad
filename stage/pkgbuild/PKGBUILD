pkgname=stage
pkgver=0.2.0
pkgrel=1
pkgdesc='iPad-style multitasking gestures for Omarchy on a tablet'
arch=('x86_64' 'aarch64')
license=('MIT')
depends=('qt6-base' 'qt6-declarative' 'qt6-wayland' 'layer-shell-qt' 'wayland' 'libinput' 'hyprland' 'uwsm')
makedepends=('gcc' 'make' 'wayland-protocols')
source=()
sha256sums=()

build() {
  cd "$startdir/.."
  ./bin/build
}

package() {
  cd "$startdir/.."
  install -Dm755 build/stage "$pkgdir/usr/bin/stage"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
