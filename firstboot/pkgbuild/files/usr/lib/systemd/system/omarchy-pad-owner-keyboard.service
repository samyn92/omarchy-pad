# Omarchy Pad: a touch keyboard on the console while Omarchy's first-boot owner setup asks for the user, its password
# and the hostname on tty1 (omarchy-provision-owner.service). A tablet has no keyboard of its own; buffyboard draws one
# on the framebuffer and types through /dev/uinput. Started and stopped by the owner setup's drop-in
# (omarchy-provision-owner.service.d/50-omarchy-pad-keyboard.conf), so it never runs on a machine already set up.
[Unit]
Description=Omarchy Pad: touch keyboard for the first-boot owner setup
Documentation=file:///usr/share/doc/omarchy-pad-firstboot/README.md
ConditionPathExists=/var/lib/omarchy/provisioning/pending
# After Omarchy's deferred hardware setup (the pacman keyring and the hardware scripts, minutes on a first boot), which
# comes before the form anyway: the keyboard quits Plymouth, and the screen would be dark until the form came.
After=systemd-user-sessions.service systemd-udev-settle.service omarchy-provision-hardware.service
Before=omarchy-provision-owner.service

[Service]
# Ready once buffyboard can take the signal that makes room for it (see the script)
Type=notify
NotifyAccess=all
# Plymouth holds the framebuffer until it quits; the owner setup quits it too, whichever comes first
ExecStartPre=-/usr/bin/plymouth quit
ExecStartPre=-/usr/bin/modprobe uinput
# buffyboard, kept above the form when the form changes the console font
ExecStart=/usr/lib/omarchy-pad/owner-keyboard
Restart=on-failure
RestartSec=1
