{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "QT_IM_MODULE": "none"
  },
  "permissions": {
    "allow": [
      "Bash(bin/test)",
      "Bash(*/bin/test)",
      "Bash(bin/build)",
      "Bash(*/bin/build)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(hyprctl -j:*)",
      "Bash(journalctl --user:*)",
      "Bash(floatkey status)",
      "Bash(stage status)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-live-hyprland.sh",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
